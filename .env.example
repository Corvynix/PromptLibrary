NODE_ENV=development
PORT=5000
DATABASE_URL=postgresql://user:password@localhost:5432/awal_beyaa
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters-long
SITE_URL=

# Configure only when deploying behind a known reverse proxy. Set the exact
# trusted proxy hop count; leave unset for direct connections.
# TRUST_PROXY_HOPS=1

# Required for payment-proof uploads. Keep the service role key server-only.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-service-role-key

# Feature flags seed initial database values. Admin-managed DB values take precedence after seeding.
ENABLE_COMMUNITY=true
ENABLE_MEMBERSHIP=true
ENABLE_AI_OPERATOR=false
ENABLE_RADAR=true
ENABLE_VAULT=true
ENABLE_PUBLIC_PROJECTS=true
ENABLE_MANUAL_PAYMENTS=true
